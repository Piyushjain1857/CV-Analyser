# ========================================================
# CV Insight AI Backend Environment Configuration (.env.example)
# ========================================================

# Server Configuration
PORT=5001
NODE_ENV=production

# Frontend Origin for CORS & Secure HTTP-only Cookies
# Local: http://localhost:5173
# Production: https://cv-insight-ai.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (Neon PostgreSQL 16)
# Format for Neon: postgresql://[user]:[password]@[ep-xyz.region.aws.neon.tech]/[dbname]?sslmode=require
# If using Neon Connection Pooling (PgBouncer), append &pgbouncer=true
DATABASE_URL=postgresql://piyush@localhost:5432/cv_insight_db?schema=public

# Security & Session Authentication
# Generate strong 64-character random strings in production
JWT_SECRET=super_secret_production_jwt_signing_key_cv_insight_2026_xyz
COOKIE_SECRET=super_secret_cookie_parser_secret_key_2026_secure

# Google Gemini API Key
# Obtain at: https://aistudio.google.com/app/apikey
# If omitted or invalid, the backend automatically engages its resilient heuristic ATS fallback engine
GEMINI_API_KEY=your_gemini_api_key_here

{
  "name": "cv-insight-ai-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "CV Insight AI Express.js and Prisma backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/**/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node src/prisma/seed.js",
    "db:setup": "prisma db push && node src/prisma/seed.js"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.13.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0"
  }
}

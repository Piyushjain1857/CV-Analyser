datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  password          String
  name              String
  role              String            @default("Senior Full-Stack Developer")
  industry          String            @default("Software & SaaS")
  experienceLevel   String            @default("Senior (5-8 yrs)")
  avatarUrl         String?
  bio               String?           @default("Crafting resilient cloud-native web architectures and optimizing technical portfolios.")
  targetScore       Int               @default(90)
  dataRetentionDays Int               @default(90)
  retainRawText     Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  resumes           Resume[]
  analyses          Analysis[]
  analysisHistories AnalysisHistory[]
  chatMessages      ChatMessage[]
  builderResumes    BuilderResume[]
  roadmaps          LearningRoadmap[]
  interviewPractices InterviewPractice[]
}

model Resume {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  candidateName     String
  fileName          String
  fileSize          Int               @default(0)
  fileType          String            @default("application/pdf")
  rawText           String?
  status            String            @default("analyzed")
  targetRole        String
  targetIndustry    String?           @default("Tech")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  analyses          Analysis[]
  analysisHistories AnalysisHistory[]
  chatMessages      ChatMessage[]

  @@index([userId, createdAt])
}

model Analysis {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId          String
  resume            Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  overallScore      Int
  atsScore          Int
  keywordScore      Int
  formatScore       Int
  skillScore        Int
  summary           String
  strengths         String[]
  weaknesses        String[]
  missingKeywords   String[]
  recommendations   String[]
  rawAnalysisJson   String?
  createdAt         DateTime          @default(now())
  analysisHistories AnalysisHistory[]
  chatMessages      ChatMessage[]

  @@index([userId, createdAt])
  @@index([resumeId])
}

model AnalysisHistory {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId    String
  resume      Resume    @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  analysisId  String?
  analysis    Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  score       Int
  actionType  String    @default("INITIAL_SCAN")
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([resumeId])
}

model ChatMessage {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId   String?
  resume     Resume?   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  analysisId String?
  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  role       String    // "user" | "assistant"
  content    String
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([resumeId])
}

model SystemMetric {
  id             String   @id @default(uuid())
  serviceName    String   @default("cv-insight-core")
  status         String   @default("healthy")
  responseTimeMs Int      @default(12)
  checkedAt      DateTime @default(now())
}

model BuilderResume {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String          @default("Untitled Resume")
  template         String          @default("modern-minimal") // "classic-professional" | "modern-minimal" | "technical-developer"
  fontFamily       String          @default("sans")           // "sans" | "serif" | "mono"
  fontSize         String          @default("medium")         // "compact" | "medium" | "spacious"
  accentColor      String          @default("#8B5CF6")
  sectionOrder     String[]        @default(["personal", "summary", "experience", "education", "projects", "skills", "certifications", "achievements", "links"])
  
  // Structured JSON fields
  personalInfo     String?         // JSON: { fullName, targetTitle, email, phone, location, linkedin, github, portfolio, website }
  summary          String?         // text
  experiences      String?         // JSON: Array<{ id, role, company, location, startDate, endDate, current, bullets: string[] }>
  education        String?         // JSON: Array<{ id, school, degree, field, startDate, endDate, gpa, honors }>
  projects         String?         // JSON: Array<{ id, name, description, techStack: string[], link, bullets: string[] }>
  skills           String?         // JSON: { languages: string[], frameworks: string[], databases: string[], tools: string[], other: string[] }
  certifications   String?         // JSON: Array<{ id, name, issuer, date, credentialUrl }>
  achievements     String?         // JSON: Array<{ id, title, description, date }>
  links            String?         // JSON: Array<{ id, label, url }>

  // Targeted optimization data
  targetJobTitle   String?
  targetJobDesc    String?
  targetMatchScore Int?

  // Version tracking & draft
  versionName      String?         @default("v1.0")
  isDraft          Boolean         @default(false)
  parentId         String?         // For cloned / branched resumes

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  versions         ResumeVersion[]

  @@index([userId, createdAt])
}

model ResumeVersion {
  id              String        @id @default(uuid())
  builderResumeId String
  builderResume   BuilderResume @relation(fields: [builderResumeId], references: [id], onDelete: Cascade)
  versionName     String
  contentSnapshot String        // Full JSON snapshot
  createdAt       DateTime      @default(now())

  @@index([builderResumeId, createdAt])
}

model LearningRoadmap {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId        String?
  targetRole      String
  title           String   @default("30-60-90 Day Career Acceleration Roadmap")
  plan30Day       String   // JSON string of task array
  plan60Day       String   // JSON string of task array
  plan90Day       String   // JSON string of task array
  overallProgress Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
}

model InterviewPractice {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId             String?
  targetRole           String
  questionType         String   // "technical" | "behavioral" | "resume-specific"
  question             String
  contextClue          String?
  userAnswer           String?
  relevanceScore       Int?
  clarityScore         Int?
  completenessScore    Int?
  overallScore         Int?
  starEvaluation       String?  // JSON string: { situation, task, action, result }
  feedback             String?
  suggestedImprovement String?
  disclaimer           String   @default("AI-generated interview guidance for preparation purposes only; not a hiring decision or employment guarantee.")
  status               String   @default("evaluated")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, targetRole])
}
